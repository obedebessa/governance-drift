          "govdrift.io/revision": "fleet-r1",
          "govdrift.io/churn": "true"
        }
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxSurge": 1,
            "maxUnavailable": 0
          }
        },
        "selector": {
          "matchLabels": {
            "govdrift.io/unit": "fleet-0000"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "govdrift-fleet",
              "govdrift.io/unit": "fleet-0000",
              "govdrift.io/revision": "fleet-r1"
            }
          },
          "spec": {
            "terminationGracePeriodSeconds": 1,
            "containers": [
              {
                "name": "main",
                "image": "localhost:5001/governance-demo:1.0",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "2m",
                    "memory": "8Mi"
