{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "source.toolkit.fluxcd.io/v1",
      "kind": "GitRepository",
      "metadata": {
        "name": "trace-source",
        "namespace": "govdrift-trace"
      },
      "spec": {
        "interval": "1h",
        "ref": {
          "branch": "master"
        },
        "url": "http://govdrift-trace-git:8000/cgi-bin/git/remote.git"
      }
    },
    {
      "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
      "kind": "Kustomization",
      "metadata": {
        "name": "trace-workload",
        "namespace": "govdrift-trace"
      },
      "spec": {
        "interval": "1h",
        "path": "./workload",
        "prune": true,
        "retryInterval": "10s",
        "sourceRef": {
          "kind": "GitRepository",
          "name": "trace-source"
        },
        "targetNamespace": "govdrift-trace",
        "timeout": "2m",
        "wait": true
      }
    }
  ],
  "kind": "List"
}
