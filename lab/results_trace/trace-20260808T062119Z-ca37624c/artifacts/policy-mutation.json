{
  "apiVersion": "kyverno.io/v1",
  "kind": "Policy",
  "metadata": {
    "name": "artifact-substituter",
    "namespace": "govdrift-trace"
  },
  "spec": {
    "background": false,
    "rules": [
      {
        "match": {
          "any": [
            {
              "resources": {
                "kinds": [
                  "Pod"
                ],
                "selector": {
                  "matchLabels": {
                    "app": "payments-trace"
                  }
                }
              }
            }
          ]
        },
        "mutate": {
          "patchStrategicMerge": {
            "spec": {
              "containers": [
                {
                  "(name)": "payments-trace",
                  "image": "nginx@sha256:1eadbb07820339e8bbfed18c771691970baee292ec4ab2558f1453d26153e22d"
                }
              ]
            }
          }
        },
        "name": "substitute-materialized-artifact"
      }
    ]
  }
}
